{
    "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
    "logo": {
        "source": "~/.config/fastfetch/ascii/arch.txt",
        "height": 22,
        "padding": { "bottom": 1 }
    },
    "display": { "separator": " " },
    "modules": [
        { "key": "╭────────────────────╮", "type": "custom" },
        { "key": "│ System             │", "type": "command", "text": ". /etc/os-release; printf '%s\\n' \"$ID\"" },
        { "key": "│ ├  user           │", "type": "title", "format": "{user-name}" },
        { "key": "│ ├ 󰇅 hostname       │", "type": "title", "format": "{host-name}" },
        { "key": "│ ├ 󰅐 uptime         │", "type": "uptime" },
        { "key": "│ ├  distro         │", "type": "os" },
        { "key": "│ ├  kernel         │", "type": "kernel" },
        { "key": "│ ├  wm             │", "type": "wm" },
        { "key": "│ ├  de             │", "type": "de"},
        { "key": "│ ├  term           │", "type": "terminal" },
        { "key": "│ ├  shell          │", "type": "shell" },
        { "key": "│ └  colors         │", "type": "colors", "symbol": "circle" },
        { "key": "├────────────────────┤", "type": "custom" },
        { "key": "│ PC                 │", "type": "host", "format": "{5} {1} ({2})" },
        { "key": "│ ├ 󰢮 gpu            │", "type": "gpu", "format": "{1} {2}" },
        { "key": "│ ├ 󰓡 swap           │", "type": "swap" },
        { "key": "│ ├ 󰍛 cpu            │", "type": "cpu", "showPeCoreCount": true },
        { "key": "│ ├ 󰉉 disk           │", "type": "disk", "folders": "/" },
        { "key": "│ ├  memory         │", "type": "memory" },
        { "key": "│ ├  display        │", "type": "monitor", "format": "{1} {2}x{3} @ {11} Hz - {4} × {5} mm ({6} inches, {7} PPI)" },
        { "key": "│ └  installed for  │", "type": "command", "text": "birth_install=$(stat -c %W /); current=$(date +%s); time_progression=$((current - birth_install)); days_difference=$((time_progression / 86400)); echo $days_difference days" },
        { "key": "╰────────────────────╯", "type": "custom" }
    ]
}
